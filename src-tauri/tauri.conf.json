{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeSpeech",
  "version": "0.2.0",
  "identifier": "media.knapp.freespeech",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FreeSpeech",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#14161B"
      },
      {
        "label": "overlay",
        "title": "FreeSpeech Anzeige",
        "url": "overlay.html",
        "width": 560,
        "height": 168,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Knapp Media",
    "shortDescription": "Lokales Diktieren per Tastenkürzel",
    "longDescription": "Tastenkürzel halten, sprechen, loslassen: der Text steht im aktiven Fenster. Läuft komplett lokal.",
    "copyright": "Knapp Media. Engine: transcribe.cpp (MIT)."
  }
}